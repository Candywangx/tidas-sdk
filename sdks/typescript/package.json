{
  "name": "@tiangong-lca/tidas-sdk",
  "version": "0.5.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "require": "./dist/schemas/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js"
    },
    "./parity": {
      "types": "./dist/parity/index.d.ts",
      "import": "./dist/parity/index.js",
      "require": "./dist/parity/index.js"
    },
    "./xml": {
      "types": "./dist/xml/index.d.ts",
      "import": "./dist/xml/index.js",
      "require": "./dist/xml/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "require": "./dist/tools/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "require": "./dist/contracts/index.js"
    }
  },
  "scripts": {
    "build": "tsx scripts/bundle-methodologies.ts && tsc && tsx scripts/copy-runtime-assets.ts",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "pnpm clean",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:examples && pnpm build",
    "bundle-methodologies": "tsx scripts/bundle-methodologies.ts",
    "sync-runtime-assets": "tsx scripts/sync-runtime-assets.ts",
    "sync-public-rules": "tsx scripts/sync-public-rules.ts",
    "verify-public-rules": "tsx scripts/sync-public-rules.ts --verify-bundled",
    "copy-runtime-assets": "tsx scripts/copy-runtime-assets.ts",
    "generate-types": "tsx scripts/generate-types.ts",
    "generate-schemas": "tsx scripts/generate-zod-schemas.ts",
    "verify:schema-generation-parity": "tsx scripts/verify-zod-generation-parity.ts",
    "lint": "oxlint --format=stylish src scripts tests",
    "lint:fix": "oxlint --fix --format=stylish src scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"scripts/**\" --test-coverage-include=\"../../scripts/ci/tidas-tools-assets.mjs\" --test-coverage-lines=95 --test-coverage-branches=75 --test-coverage-functions=70 \"src/**/*.test.ts\" \"tests/**/*.test.mjs\"",
    "check:examples": "pnpm --filter tidas-sdk-examples check",
    "verify:release": "bash ../../scripts/ci/verify-typescript-package.sh",
    "release:prepare:patch": "pnpm version patch --no-git-tag-version",
    "release:prepare:minor": "pnpm version minor --no-git-tag-version",
    "release:prepare:major": "pnpm version major --no-git-tag-version"
  },
  "keywords": [
    "tidas",
    "ilcd",
    "lca",
    "typescript",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "description": "TypeScript SDK for ILCD/Tidas data management",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiangong-lca/tidas-sdks.git",
    "directory": "sdks/typescript"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "dotenv": "^17.4.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "24.19.0"
  },
  "dependencies": {
    "jsonschema": "^1.5.0",
    "xmltodict": "^1.0.5",
    "zod": "^4.6.5"
  }
}
