{
  "name": "tidas-sdk-examples",
  "version": "1.0.0",
  "private": true,
  "description": "Examples for @tiangong-lca/tidas-sdk",
  "scripts": {
    "typecheck": "pnpm exec tsc --noEmit --project tsconfig.json",
    "test-imports": "pnpm exec tsx --tsconfig tsconfig.json test-imports.ts",
    "run-contact-draft": "pnpm exec tsx --tsconfig tsconfig.json 01-basic-usage/contact-draft.ts",
    "run-xml-roundtrip": "pnpm exec tsx --tsconfig tsconfig.json 02-xml-roundtrip/xml-roundtrip.ts",
    "check": "pnpm typecheck && pnpm test-imports && pnpm run-contact-draft && pnpm run-xml-roundtrip"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tiangong-lca/tidas-sdk": "workspace:*"
  }
}
